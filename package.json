{
  "name": "remotepad",
  "version": "0.2.0",
  "description": "low-latency UDP remote input server and layout editor",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "remote",
    "keypad",
    "gamepad",
    "udp",
    "rust",
    "solid",
    "tailwind"
  ],
  "author": "eunhhu",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/eunhhu/remotepad.git"
  },
  "bugs": {
    "url": "https://github.com/eunhhu/remotepad/issues"
  },
  "homepage": "https://github.com/eunhhu/remotepad#readme",
  "dependencies": {
    "lucide-solid": "^0.468.0",
    "solid-js": "^1.9.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-solid": "^2.11.0"
  },
  "overrides": {
    "anymatch": {
      "picomatch": "^2.3.2"
    },
    "micromatch": {
      "picomatch": "^2.3.2"
    },
    "readdirp": {
      "picomatch": "^2.3.2"
    }
  }
